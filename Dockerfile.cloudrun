FROM python:3.13-slim
ENV PYTHONUNBUFFERED=1 \
    GECO_DEMO_TEMPLATE=/app/demo_data/starter.geco \
    GECO_DEMO_SEMANTIC=1 \
    HF_HOME=/tmp/hf-cache \
    PORT=8080
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends build-essential && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir uv
COPY pyproject.toml uv.lock .python-version ./
COPY src/ ./src/
COPY demo/ ./demo/
RUN uv sync --frozen --no-dev --extra embeddings && uv pip install --python .venv/bin/python flask gunicorn
RUN .venv/bin/python -m demo.build_starter
USER 1000
EXPOSE 8080
CMD ["/app/.venv/bin/gunicorn", "--workers", "1", "--threads", "8", "--bind", "0.0.0.0:8080", "--timeout", "240", "demo.cloudrun:app"]
